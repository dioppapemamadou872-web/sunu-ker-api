# ==============================================================================
# DEKUWAAY API — CONFIGURATION PRODUCTION & DÉPLOIEMENT
# ==============================================================================

# Port d'écoute du serveur (par défaut 4000)
PORT=4000

# Mot de passe sécurisé pour la console Administrateur (/admin)
ADMIN_PASSWORD=sunukeur2026

# Clé secrète JWT pour la signature des jetons propriétaires (Générer une chaîne aléatoire longue)
JWT_SECRET=eee121bd724e7b6c4439dc6b144413d4852bfba285d312f002b84ef01e4f7f52

# URL de votre Frontend Web (Pour autoriser les requêtes CORS sécurisées en ligne)
FRONTEND_URL=https://dekuwaay.com

# ==============================================================================
# BASE DE DONNÉES CLOUD (MONGODB ATLAS)
# Laissez vide en local pour utiliser db.json ou renseignez votre URI MongoDB Atlas en ligne
# ==============================================================================
MONGODB_URI=mongodb+srv://dekuwaay_user:VOTRE_MOT_DE_PASSE@cluster0.mongodb.net/dekuwaay?retryWrites=true&w=majority

# ==============================================================================
# ENVOI D'EMAILS TRANSACTIONNELS (SMTP)
# Renseignez vos accès SMTP une fois le nom de domaine acheté (ex: contact@dekuwaay.com)
# ==============================================================================
SMTP_HOST=smtp.votreebergeur.com
SMTP_PORT=587
SMTP_USER=contact@dekuwaay.com
SMTP_PASS=votre_mot_de_passe_email
EMAIL_FROM="DëkuWaay" <contact@dekuwaay.com>

# ==============================================================================
# STOCKAGE D'IMAGES & VIDÉOS EN LIGNE (CLOUDINARY)
# Laissez vide en local pour stocker dans /uploads ou renseignez vos clés Cloudinary en ligne
# ==============================================================================
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
